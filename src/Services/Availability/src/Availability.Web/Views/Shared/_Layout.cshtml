<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Asientos") · Availability</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a href="/"><strong>Availability</strong></a>
        <nav>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Account/Profile">@User.Identity.Name</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit">Salir</button>
                </form>
            }
            else
            {
                <a href="/Account/Login">Ingresar</a>
            }
        </nav>
    </header>
    <main>
        @if (TempData["Info"] is string info)
        {
            <div class="msg info" role="status">@info</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="msg error" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
