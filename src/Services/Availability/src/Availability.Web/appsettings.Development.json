{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    // Clave de DESARROLLO compartida con el Auth Server (rama feature/06-auth-server-m2m). En contenedores/producción
    // se define por variable de entorno Jwt__Key; nunca va en appsettings.json.
    "Key": "SeatsReservation-Dev-Key-Change-Me-Min-32-Bytes!!"
  },
