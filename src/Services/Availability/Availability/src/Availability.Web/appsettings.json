{
  "ConnectionStrings": {
    "Availability": "Data Source=availability.db"
  },
  "AzureQueue": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "ReservationSync": {
    "PendingTimeoutMinutes": 10
  },
  "Booking": {
    "BaseUrl": "http://localhost:5102",
    "TimeoutSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
