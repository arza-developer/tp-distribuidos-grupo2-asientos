<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".template.config/template.json" />
    <File Path="CleanArchitecture.nuspec" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/Availability.Core/Availability.Core.csproj" />
    <Project Path="src/Availability.Infrastructure/Availability.Infrastructure.csproj" />
    <Project Path="src/Availability.UseCases/Availability.UseCases.csproj" />
    <Project Path="src/Availability.Web/Availability.Web.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Availability.FunctionalTests/Availability.FunctionalTests.csproj">
      <BuildDependency Project="src/Availability.Web/Availability.Web.csproj" />
    </Project>
    <Project Path="tests/Availability.IntegrationTests/Availability.IntegrationTests.csproj">
      <BuildDependency Project="src/Availability.Infrastructure/Availability.Infrastructure.csproj" />
    </Project>
    <Project Path="tests/Availability.UnitTests/Availability.UnitTests.csproj" />
  </Folder>
</Solution>
